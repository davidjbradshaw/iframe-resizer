---
import IframeResizer from '@iframe-resizer/astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro E2E Test</title>
    <style>
      iframe { width: 100%; height: 100vh; }
    </style>
  </head>
  <body>
    <h2>@iframe-resizer/astro example</h2>
    <IframeResizer
      license="GPLv3"
      id="myIframe"
      log
      inPageLinks
      src="child/frame.test.html"
    />
    <script is:inline>
      // As record() in e2e/shared/app.js, which an inline script cannot import
      window.callbacks = []
      const record = (callback, detail) =>
        window.callbacks.push({ callback, ...detail })

      // The e2e tests set cancelScroll to check the event can stop a scroll
      window.cancelScroll = false
      window.scrollEvents = 0
      document.addEventListener('iframe-resizer:scroll', (event) => {
        record('onScroll')
        window.scrollEvents += 1
        if (window.cancelScroll) event.preventDefault()
      })
      document.addEventListener('iframe-resizer:ready', () => record('onReady'))
      document.addEventListener('iframe-resizer:resized', (event) =>
        record('onResized', { type: event.detail.type }),
      )
      document.addEventListener('iframe-resizer:message', (event) =>
        record('onMessage', { message: event.detail.message }),
      )
    </script>
  </body>
</html>
