{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "lib": ["ES2022", "DOM"],
    "outDir": "out"
  },
  "include": ["src/**/*.ts"]
}
