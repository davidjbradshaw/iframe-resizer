{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "allowJs": false,
    "strict": false,
    "declaration": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "packages/global.d.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "packages/**/*.test.*",
    "packages/solid/**"
  ]
}
